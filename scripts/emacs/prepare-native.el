;;; prepare-native.el --- Prepare isolated comparison libraries -*- lexical-binding: t; -*-
(setq native-comp-jit-compilation nil)
(require 'compile)
(require 'comp)
(require 'bytecomp)
(require 'json)
(unless (native-comp-available-p) (error "Native compilation unavailable"))
(let ((directory (getenv "BENCH_NATIVE_DIR")) metadata)
  (startup-redirect-eln-cache (expand-file-name "cache" directory))
  (dolist (library '("button" "font-lock" "jit-lock" "ansi-color" "comint" "compile"))
    (let* ((source (locate-library (concat library ".el")))
           (copy (expand-file-name (concat library ".el") directory))
           (output (expand-file-name (concat library ".eln") directory)))
      (unless source (error "Source not found: %s" library))
      (copy-file source copy t)
      (unless (byte-compile-file copy) (error "Byte compilation failed: %s" library))
      (native-compile copy output)
      (unless (file-exists-p output) (error "Native output missing: %s" library))
      (push `((name . ,library) (source . ,source)
              (source_sha256 . ,(with-temp-buffer (insert-file-contents-literally source)
                                                (secure-hash 'sha256 (current-buffer))))
              (native_sha256 . ,(with-temp-buffer (insert-file-contents-literally output)
                                                (secure-hash 'sha256 (current-buffer))))) metadata)))
  (with-temp-file (expand-file-name "metadata.json" directory)
    (insert (json-encode `((native_comp_speed . ,native-comp-speed)
                          (libraries . ,(vconcat (nreverse metadata))))))))
