;;; benchmark.el --- compilation benchmark -*- lexical-binding: t; -*-
(setq native-comp-jit-compilation nil)
(require 'compile)
(defvar benchmark-library-functions
  '(compilation-parse-errors compilation--ensure-parse compilation-filter
    comint-carriage-motion font-lock-fontify-region jit-lock-fontify-now
    ansi-color-apply-on-region button-at))
(let ((directory (getenv "BENCH_NATIVE_DIR"))
      (code (getenv "BENCH_EMACS_CODE")))
  (when directory
    (startup-redirect-eln-cache (expand-file-name "cache" directory))
    (dolist (library '("button" "font-lock" "jit-lock" "ansi-color" "comint" "compile"))
      (load (expand-file-name (concat library (if (equal code "native") ".eln" ".elc")) directory)
            nil t t))
    (dolist (function benchmark-library-functions)
      (unless (eq (and (native-comp-function-p (symbol-function function)) t)
                  (equal code "native"))
        (error "Unexpected code kind for %s" function)))))
(require 'json)
(setq compilation-ask-about-save nil compilation-scroll-output nil)
(let* ((file (getenv "BENCH_INPUT"))
       (mode (getenv "BENCH_MODE"))
       (samples (string-to-number (getenv "BENCH_SAMPLES")))
       (text (with-temp-buffer (insert-file-contents file) (buffer-string)))
       (rows nil))
  (dotimes (iteration (1+ samples))
    (let ((buf (get-buffer-create "*comparison*"))
          (gap 0.0) (last nil) (timer nil) (finished nil)
          started elapsed found records gc-start gc-time-start gc-count gc-ms)
      (when (equal mode "parse")
        (with-current-buffer buf
          (let ((inhibit-read-only t)) (erase-buffer) (insert text))
          (compilation-mode)))
      (garbage-collect)
      (setq gc-start gcs-done gc-time-start gc-elapsed
            started (float-time) last started)
      (if (equal mode "parse")
          (with-current-buffer buf (compilation--ensure-parse (point-max)))
        (setq timer (run-at-time 0.005 0.005
                                (lambda ()
                                  (let ((now (float-time)))
                                    (setq gap (max gap (- now last)) last now)))))
        (let ((compilation-buffer-name-function (lambda (_) "*comparison*"))
              (compilation-finish-functions
               (list (lambda (_buf msg)
                       (unless (string-prefix-p "finished" msg) (error "Compilation failed: %s" msg))
                       (setq finished t)))))
          (setq buf (compilation-start (concat "cat " (shell-quote-argument file))))
          (while (not finished)
            (when (> (- (float-time) started) 60) (error "Timeout"))
            (accept-process-output nil 0.001)))
        (with-current-buffer buf (compilation--ensure-parse (point-max))))
      (setq elapsed (* 1000 (- (float-time) started))
            gap (* 1000 (max gap (- (float-time) last))))
      (setq gc-count (- gcs-done gc-start) gc-ms (* 1000 (- gc-elapsed gc-time-start)))
      (when timer (cancel-timer timer))
      ;; Validation and record extraction are outside timing.
      (with-current-buffer buf
        (goto-char (point-min))
        (unless (search-forward text nil t)
          (error "Output changed"))
        (setq found 0)
        (goto-char (point-min))
        (while (< (point) (point-max))
          (let* ((end (line-end-position))
                 (msg (or (get-text-property (point) 'compilation-message)
                          (let ((p (next-single-property-change (point) 'compilation-message nil end)))
                            (and (< p end) (get-text-property p 'compilation-message))))))
            (when msg
              (setq found (1+ found))
              (push (buffer-substring-no-properties (line-beginning-position) end) records)))
          (forward-line 1)))
      (when (> iteration 0)
        (push `((ms . ,elapsed) (gap_ms . ,gap) (recognized . ,found)
                (gc_count . ,gc-count)
                (gc_ms . ,gc-ms)) rows))
      (when (= iteration samples)
        (with-temp-file (concat (getenv "BENCH_RESULT") ".records")
          (dolist (line (nreverse records)) (insert line "\n"))))
      (when (equal mode "parse") (kill-buffer buf))))
  (with-temp-file (getenv "BENCH_RESULT")
    (insert (json-encode `((editor . ,emacs-version)
                          (code_kind . ,(or (getenv "BENCH_EMACS_CODE") "installed"))
                          (build_options . ,system-configuration-options)
                          (function_native_status . ,(mapcar
                            (lambda (function) (cons function (and (fboundp 'native-comp-function-p)
                              (fboundp function) (native-comp-function-p (symbol-function function)))) )
                            benchmark-library-functions)) (mode . ,mode)
                          (gc_cons_threshold . ,gc-cons-threshold)
                          (native_comp_available . ,(and (fboundp 'native-comp-available-p) (native-comp-available-p)))
                          (compile_library . ,(locate-library "compile"))
                          (process_connection_type . ,process-connection-type)
                          (read_process_output_max . ,read-process-output-max)
                          (max_output_line_length . ,compilation-max-output-line-length)
                          (rules . ,(length compilation-error-regexp-alist))
                          (samples . ,(vconcat (nreverse rows))))))))
